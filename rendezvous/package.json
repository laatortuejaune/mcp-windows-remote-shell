{
  "name": "relay-rendezvous",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Persistent package credentials and authenticated remote-support sessions.",
  "scripts": {
    "deploy": "wrangler deploy --config wrangler.local.jsonc",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "typecheck": "pnpm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "4.129.0"
  }
}
