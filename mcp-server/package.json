{
  "name": "relay-mcp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "MCP server (stdio) exposing run_command / check_agent over an outbound relay tunnel.",
  "bin": {
    "relay-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepare-target": "pnpm run build && node dist/prepare.js",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
